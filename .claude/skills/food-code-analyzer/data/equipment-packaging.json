{
  "metadata": {
    "name": "기구 및 용기·포장공전",
    "source": "식품의약품안전처",
    "url": "https://www.foodsafetykorea.go.kr/foodcode/02_01.jsp",
    "last_updated": "2026-07-15"
  },
  "entries": [
    {
      "category": "플라스틱",
      "term": "폴리에틸렌(PE)",
      "type": "용기·포장",
      "definition": "폴리에틸렌은 플라스틱 용기·포장의 주요 소재로서 저밀도(LDPE)와 고밀도(HDPE)로 구분되며, 식품 접촉면은 회색 이상의 색상이어야 한다.",
      "standard": "용융지수: LDPE 2~7 g/10min, HDPE 0.3~10 g/10min"
    },
    {
      "category": "플라스틱",
      "term": "폴리프로필렌(PP)",
      "type": "용기·포장",
      "definition": "폴리프로필렌은 식품 용기, 뚜껑 등에 사용되는 플라스틱으로서 내열성이 높고, 투명성이 우수하다.",
      "standard": "용융지수: 4~12 g/10min"
    },
    {
      "category": "플라스틱",
      "term": "폴리에틸렌테레프탈레이트(PET)",
      "type": "용기·포장",
      "definition": "PET는 음료 병, 식품 용기 등에 사용되는 플라스틱으로서 강도가 높고, 투명성이 우수하며, 재활용성이 좋다.",
      "standard": "고유 점도: 0.70~0.80 dL/g"
    },
    {
      "category": "플라스틱",
      "term": "폴리염화비닐(PVC)",
      "type": "용기·포장",
      "definition": "PVC는 가공성이 우수하여 다양한 용기·포장에 사용되며, 가소제 종류에 따라 기준이 다르게 적용된다.",
      "standard": "식품 접촉면 안정성 평가 필수"
    },
    {
      "category": "종이",
      "term": "판지(골판지)",
      "type": "용기·포장",
      "definition": "판지는 식품 포장재로 사용되며, 백판지, 골판지, 라미네이트 판지 등이 있고, 형광증백제 기준이 있다.",
      "standard": "형광증백제: 300mg/kg 이하(일부 제품 제외)"
    },
    {
      "category": "종이",
      "term": "종이(백판지)",
      "type": "용기·포장",
      "definition": "백판지는 우유팩, 식품 포장 등에 사용되며, 인쇄 잉크, 접착제 등에 대한 기준이 있다.",
      "standard": "중금속(납, 카드뮴) 용출 기준 준수"
    },
    {
      "category": "유리",
      "term": "유리",
      "type": "용기·포장",
      "definition": "유리는 화학적으로 안정하여 식품 용기·포장으로 널리 사용되며, 강화유리, 열강화유리 등이 있다.",
      "standard": "납, 카드뮴 용출: 납 0.5mg/L, 카드뮴 0.1mg/L 이하"
    },
    {
      "category": "알루미늄",
      "term": "알루미늄 호일",
      "type": "용기·포장",
      "definition": "알루미늄 호일은 산소 차단성이 우수하여 포장재로 널리 사용되며, 순 알루미늄 90% 이상이어야 한다.",
      "standard": "두께: 0.009~0.2mm"
    },
    {
      "category": "알루미늄",
      "term": "알루미늄 용기",
      "type": "용기·포장",
      "definition": "알루미늄 용기는 주로 음료 캔, 식품 용기로 사용되며, 코팅 상태, 두께 등에 기준이 있다.",
      "standard": "코팅 필수, 두께: 0.065~0.2mm"
    },
    {
      "category": "스테인리스강",
      "term": "스테인리스강(SUS304/316)",
      "type": "용기·포장",
      "definition": "스테인리스강은 기구·용기로 사용되며, SUS304, SUS316 등 규격이 있고, 식품 접촉면 재질 기준이 있다.",
      "standard": "니켈 용출: 0.1mg/dm²·day 이하"
    }
  ]
}
